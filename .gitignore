# secrets
.env
.env.*
!.env.example

# dependencies and build output
node_modules/
.next/
out/
.vercel/
*.tsbuildinfo

# raw capture material: every take is tens of megabytes and nothing in the site or the
# film composition reads it directly. The JSON logs beside each take are kept, because
# the film build script needs the beat and pointer timings to reassemble a shot.
agent-runs/*
!agent-runs/*/
agent-runs/**/*.mp4
agent-runs/**/*.png
agent-runs/**/*.jpg

# film intermediates: cut shots, montage sources and past renders. The finished film is
# committed under landing/public/video; these are regenerated by scripts/build-film-final.mjs.
videos/*/renders/
videos/*/out/
videos/*/assets/thirty/
videos/*/assets/gui/
videos/*/assets/final/

# scraped reference material from other companies' sites
landing/reference/
landing/docs/design-references/

# os and editor noise
.DS_Store
*.log

# a skill copied in for one research task, not part of the project
.agents/
.claude/
var/
