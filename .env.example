# Solari provides the machines the leases run on (getsolari.com)
SOLARI_API_KEY=

# Blocky402 facilitator, x402 on Hedera. The fee payer is read from its /supported
# response at runtime and is never hardcoded.
FACILITATOR_URL=https://facilitator.blocky402.com

# The account the gateway settles from, and the HCS topic it writes checkpoints to
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
HCS_TOPIC_ID=
