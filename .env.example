# ── Gateway (src/gateway/server.mjs) ────────────────────────────────────────────────

# testnet unless set to mainnet. Every network-specific id lives in src/networks.mjs.
HEDERA_NETWORK=testnet

# The account every x402 payment settles into. Its key signs the HCS anchors.
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=

# The topic the meter publishes chain heads to. `npm run bootstrap` creates one.
HCS_TOPIC_ID=

# Where the machines come from: desktops, Linux machines and the fast browser pool,
# then the stealth browser (residential egress, CAPTCHA solving).
SOLARI_API_KEY=
BROWSER_USE_API_KEY=

PORT=8787
PUBLIC_ORIGIN=http://localhost:8787

# MAX_LEASE_SECONDS=3600
# LOW_WATER_SECONDS=60
# ANCHOR_EVERY_SEC=60
# LEASE_STORE=var/leases.json
# JOB_STORE=var/jobs.json
# JOB_CONCURRENCY=2
# DELIVERABLES_DIR=var/deliverables

# Local testing only: POST /v1/sessions/:id/dev-credit funds a session without paying.
# Never set this on a gateway anyone else can reach.
# KLEETO_DEV_CREDIT=1

# ── Hosted demo (kleeto.fun/demo) ──────────────────────────────────────────────────

# Shared secret between the gateway and its workers.
WORKER_TOKEN=
# The demo agent's Hedera account, shown on the demo page.
DEMO_AGENT_ID=

# Worker (src/worker/runner.mjs)
KLEETO_GATEWAY=http://127.0.0.1:8787
# RUN_DIR=/home/codex/runs
# JOB_BUDGET_MS=2700000

# The MCP server the demo agents call (src/mcp/kleeto-mcp.mjs): the agent's own wallet.
AGENT_ACCOUNT_ID=
AGENT_PRIVATE_KEY=
